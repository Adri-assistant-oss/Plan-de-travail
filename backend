/**
 * Classeur AMD International — backend de synchronisation Google Sheets v3
 *
 * NOUVEAUTÉS vs v2 :
 * - Champs ajoutés : HeureLimite (heure précise de l'échéance) et Commentaire
 *   (séparé de Notes)
 * - Fuseau horaire fixe pour tout le classeur (constante FUSEAU_HORAIRE),
 *   utilisé pour formater les dates et calculer les échéances correctement
 * - Validation du Statut par liste déroulante sur la feuille
 * - Champs calculés à l'affichage : JoursRestants et Urgence
 *   ("urgent" / "proche" / "normal") — jamais stockés, toujours à jour
 * - Nouvelle action "search" : filtrer par Statut / Acheteur / Type / texte
 * - Nouvelle action "exportCsv" : export CSV en un appel
 * - list() trié automatiquement par échéance la plus proche
 * - Rappels email plus précis (date + heure + fuseau réel), seuil
 *   configurable via Script Property RAPPEL_JOURS (3 par défaut)
 * - Gestion d'erreurs globale (try/catch), messages clairs
 *
 * INSTALLATION :
 * 1. Crée un Google Sheet vide (n'importe quel nom).
 * 2. Menu Extensions > Apps Script.
 * 3. Supprime le contenu par défaut et colle tout ce fichier.
 * 4. Menu Project Settings (roue crantée à gauche) > Script Properties
 *    > Add script property : clé = CLASSEUR_TOKEN, valeur = un mot de passe
 *    que tu choisis (garde-le, c'est lui qui protège tes données).
 *    (Optionnel) Ajoute aussi RAPPEL_JOURS (ex: "3") pour changer le seuil
 *    de rappel.
 * 5. Menu Deploy > New deployment > type "Web app".
 *    - Execute as: Me
 *    - Who has access: Anyone
 * 6. Copie l'URL générée (se termine par /exec).
 * 7. (Optionnel) Menu Triggers (horloge à gauche) > Add Trigger >
 *    fonction "verifierEcheances" > Time-driven > Day timer
 *    -> pour recevoir un email quand une échéance approche.
 *
 * APPELS DEPUIS L'ARTEFACT (exemples) :
 * GET  {url}?token=XXX&action=list
 * GET  {url}?token=XXX&action=stats
 * GET  {url}?token=XXX&action=get&id=xxx-xxx
 * GET  {url}?token=XXX&action=search&statut=En+cours&acheteur=UNICEF&texte=eau
 * GET  {url}?token=XXX&action=exportCsv
 * POST {url}  body: { token, action:"add", dossier:{ Nom, Type, Acheteur, Statut, DateLimite, HeureLimite, Montant, Notes, Commentaire } }
 * POST {url}  body: { token, action:"update", id, dossier:{ ...champs à changer } }
 * POST {url}  body: { token, action:"delete", id }
 * POST {url}  body: { token, action:"bulkSync", dossiers:[ {...}, {...} ] }
 */

const SHEET_DOSSIERS = "Dossiers";
const SHEET_HISTORIQUE = "Historique";
const COLONNES = ["ID", "Nom", "Type", "Acheteur", "Statut", "DateLimite", "HeureLimite", "Montant", "Notes", "Commentaire", "DateCreation", "DateMAJ"];
const STATUTS_VALIDES = ["À monter", "En cours", "Déposé", "Gagné", "Perdu"];
const FUSEAU_HORAIRE = "Africa/Ouagadougou"; // fuseau fixe pour tout le classeur (GMT, sans changement d'heure)
const HEURE_PAR_DEFAUT = "17:00";

function doGet(e) {
  try {
    const authError = checkToken(e.parameter.token || "");
    if (authError) return authError;

    const action = e.parameter.action || "list";

    if (action === "list") {
      return jsonOutput(JSON.stringify({ ok: true, dossiers: listDossiersEnrichis() }));
    }
    if (action === "stats") {
      return jsonOutput(JSON.stringify({ ok: true, stats: getStats() }));
    }
    if (action === "get" && e.parameter.id) {
      const dossier = getDossierById(e.parameter.id);
      return jsonOutput(JSON.stringify({ ok: !!dossier, dossier: dossier ? enrichirDossier(dossier) : null }));
    }
    if (action === "search") {
      return jsonOutput(JSON.stringify({ ok: true, dossiers: searchDossiers(e.parameter) }));
    }
    if (action === "exportCsv") {
      return csvOutput(dossiersToCsv(listDossiersEnrichis()));
    }
    return jsonOutput(JSON.stringify({ error: "unknown_action" }));
  } catch (err) {
    return jsonOutput(JSON.stringify({ error: "server_error", message: String(err) }));
  }
}

function doPost(e) {
  try {
    let body;
    try {
      body = JSON.parse(e.postData.contents);
    } catch (err) {
      return jsonOutput(JSON.stringify({ error: "invalid_json" }));
    }

    const authError = checkToken(body.token || "");
    if (authError) return authError;

    const action = body.action || "add";

    if (action === "add") {
      const champs = body.dossier || {};
      if (!champs.Nom) {
        return jsonOutput(JSON.stringify({ error: "champ_requis", message: "Le champ Nom est obligatoire." }));
      }
      return jsonOutput(JSON.stringify({ ok: true, dossier: enrichirDossier(addDossier(champs)) }));
    }
    if (action === "update") {
      const updated = updateDossier(body.id, body.dossier || {});
      return jsonOutput(JSON.stringify({ ok: !!updated, dossier: updated ? enrichirDossier(updated) : null }));
    }
    if (action === "delete") {
      return jsonOutput(JSON.stringify({ ok: deleteDossier(body.id) }));
    }
    if (action === "bulkSync") {
      bulkReplace(body.dossiers || []);
      return jsonOutput(JSON.stringify({ ok: true, count: (body.dossiers || []).length }));
    }
    return jsonOutput(JSON.stringify({ error: "unknown_action" }));
  } catch (err) {
    return jsonOutput(JSON.stringify({ error: "server_error", message: String(err) }));
  }
}

/* ---------- CRUD ---------- */

function listDossiers() {
  const sheet = getSheet(SHEET_DOSSIERS);
  const data = sheet.getDataRange().getValues();
  return data.slice(1).filter(r => r[0]).map(rowToObject);
}

function listDossiersEnrichis() {
  const dossiers = listDossiers().map(enrichirDossier);
  dossiers.sort((a, b) => {
    if (!a._dateLimiteComplete) return 1;
    if (!b._dateLimiteComplete) return -1;
    return a._dateLimiteComplete - b._dateLimiteComplete;
  });
  return dossiers;
}

function getDossierById(id) {
  return listDossiers().find(d => d.ID === id) || null;
}

function searchDossiers(params) {
  let resultats = listDossiersEnrichis();
  if (params.statut) resultats = resultats.filter(d => d.Statut === params.statut);
  if (params.acheteur) resultats = resultats.filter(d => (d.Acheteur || "").toLowerCase().includes(params.acheteur.toLowerCase()));
  if (params.type) resultats = resultats.filter(d => d.Type === params.type);
  if (params.texte) {
    const t = params.texte.toLowerCase();
    resultats = resultats.filter(d =>
      (d.Nom || "").toLowerCase().includes(t) ||
      (d.Notes || "").toLowerCase().includes(t) ||
      (d.Commentaire || "").toLowerCase().includes(t)
    );
  }
  return resultats;
}

function addDossier(champs) {
  const sheet = getSheet(SHEET_DOSSIERS);
  const id = Utilities.getUuid();
  const now = new Date();
  const row = [
    id,
    champs.Nom || "",
    champs.Type || "AO",
    champs.Acheteur || "",
    validerStatut(champs.Statut),
    champs.DateLimite ? new Date(champs.DateLimite) : "",
    validerHeure(champs.HeureLimite),
    champs.Montant || "",
    champs.Notes || "",
    champs.Commentaire || "",
    now,
    now
  ];
  sheet.appendRow(row);
  logHistorique(id, "Création", champs.Nom || "");
  return rowToObject(row);
}

function updateDossier(id, champs) {
  const sheet = getSheet(SHEET_DOSSIERS);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === id) {
      const rowNum = i + 1;
      COLONNES.forEach((col, idx) => {
        if (champs[col] !== undefined && col !== "ID" && col !== "DateCreation") {
          let val = champs[col];
          if (col === "DateLimite" && val) val = new Date(val);
          if (col === "HeureLimite") val = validerHeure(val);
          if (col === "Statut") val = validerStatut(val);
          sheet.getRange(rowNum, idx + 1).setValue(val);
        }
      });
      sheet.getRange(rowNum, COLONNES.indexOf("DateMAJ") + 1).setValue(new Date());
      logHistorique(id, "Modification", champs.Statut || "");
      return rowToObject(sheet.getRange(rowNum, 1, 1, COLONNES.length).getValues()[0]);
    }
  }
  return null;
}

function deleteDossier(id) {
  const sheet = getSheet(SHEET_DOSSIERS);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === id) {
      sheet.deleteRow(i + 1);
      logHistorique(id, "Suppression", "");
      return true;
    }
  }
  return false;
}

function bulkReplace(dossiers) {
  const sheet = getSheet(SHEET_DOSSIERS);
  const lastRow = sheet.getLastRow();
  if (lastRow > 1) {
    sheet.getRange(2, 1, lastRow - 1, COLONNES.length).clearContent();
  }
  dossiers.forEach(addDossierSilent);
}

function addDossierSilent(champs) {
  const sheet = getSheet(SHEET_DOSSIERS);
  const now = new Date();
  sheet.appendRow([
    champs.ID || Utilities.getUuid(),
    champs.Nom || "",
    champs.Type || "AO",
    champs.Acheteur || "",
    validerStatut(champs.Statut),
    champs.DateLimite ? new Date(champs.DateLimite) : "",
    validerHeure(champs.HeureLimite),
    champs.Montant || "",
    champs.Notes || "",
    champs.Commentaire || "",
    champs.DateCreation ? new Date(champs.DateCreation) : now,
    now
  ]);
}

/* ---------- Enrichissement (champs calculés, jamais stockés) ---------- */

function enrichirDossier(dossier) {
  const dateComplete = combinerDateHeure(dossier.DateLimite, dossier.HeureLimite);
  const enrichi = Object.assign({}, dossier);
  enrichi.DateLimiteFormatee = dateComplete ? formatDateHeure(dateComplete) : "";
  enrichi._dateLimiteComplete = dateComplete;

  if (dateComplete && dossier.Statut !== "Déposé" && dossier.Statut !== "Perdu" && dossier.Statut !== "Gagné") {
    const joursRestants = Math.ceil((dateComplete - new Date()) / (1000 * 60 * 60 * 24));
    enrichi.JoursRestants = joursRestants;
    enrichi.Urgence = joursRestants < 0 ? "dépassé" : joursRestants <= 3 ? "urgent" : joursRestants <= 7 ? "proche" : "normal";
  } else {
    enrichi.JoursRestants = null;
    enrichi.Urgence = "n/a";
  }
  delete enrichi._dateLimiteComplete; // usage interne au tri uniquement
  return enrichi;
}

function combinerDateHeure(dateVal, heureStr) {
  if (!dateVal) return null;
  const date = new Date(dateVal);
  if (isNaN(date.getTime())) return null;
  const heure = (heureStr && /^\d{1,2}:\d{2}$/.test(heureStr)) ? heureStr : HEURE_PAR_DEFAUT;
  const [h, m] = heure.split(":").map(Number);
  const combinee = new Date(date);
  combinee.setHours(h, m, 0, 0);
  return combinee;
}

function formatDateHeure(date) {
  return Utilities.formatDate(date, FUSEAU_HORAIRE, "dd/MM/yyyy HH:mm") + " (" + FUSEAU_HORAIRE + ")";
}

function validerStatut(statut) {
  return STATUTS_VALIDES.includes(statut) ? statut : STATUTS_VALIDES[0];
}

function validerHeure(heure) {
  return (heure && /^\d{1,2}:\d{2}$/.test(heure)) ? heure : HEURE_PAR_DEFAUT;
}

/* ---------- Stats ---------- */

function getStats() {
  const dossiers = listDossiersEnrichis();
  const parStatut = {};
  dossiers.forEach(d => { parStatut[d.Statut] = (parStatut[d.Statut] || 0) + 1; });
  const urgents = dossiers.filter(d => d.Urgence === "urgent" || d.Urgence === "dépassé").length;
  return { total: dossiers.length, parStatut: parStatut, urgents: urgents };
}

/* ---------- Export CSV ---------- */

function dossiersToCsv(dossiers) {
  const entetes = COLONNES.concat(["JoursRestants", "Urgence"]);
  const lignes = [entetes.join(",")];
  dossiers.forEach(d => {
    const ligne = entetes.map(col => {
      let val = d[col];
      if (val instanceof Date) val = formatDateHeure(val);
      val = (val === undefined || val === null) ? "" : String(val);
      return '"' + val.replace(/"/g, '""') + '"';
    });
    lignes.push(ligne.join(","));
  });
  return lignes.join("\n");
}

/* ---------- Historique ---------- */

function logHistorique(id, action, detail) {
  getSheet(SHEET_HISTORIQUE).appendRow([new Date(), id, action, detail]);
}

/* ---------- Rappels d'échéance ---------- */
// À activer via Triggers > Add trigger > verifierEcheances > Time-driven > Day timer

function verifierEcheances() {
  const seuilJours = Number(PropertiesService.getScriptProperties().getProperty("RAPPEL_JOURS")) || 3;

  const urgents = listDossiersEnrichis().filter(d => {
    if (d.Urgence === "n/a") return false;
    return d.JoursRestants !== null && d.JoursRestants <= seuilJours;
  });

  if (urgents.length > 0) {
    const corps = urgents.map(d =>
      `- ${d.Nom} (${d.Acheteur}) — échéance ${d.DateLimiteFormatee} — ${d.JoursRestants < 0 ? "DÉPASSÉE" : d.JoursRestants + " jour(s) restant(s)"}`
    ).join("\n");
    MailApp.sendEmail(
      Session.getActiveUser().getEmail(),
      "Classeur AMD International — échéances proches",
      "Dossiers à surveiller :\n\n" + corps
    );
  }
}

/* ---------- Utilitaires ---------- */

function getSheet(nom) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(nom);
  if (!sheet) {
    sheet = ss.insertSheet(nom);
    if (nom === SHEET_DOSSIERS) {
      sheet.appendRow(COLONNES);
      const colStatut = COLONNES.indexOf("Statut") + 1;
      const regle = SpreadsheetApp.newDataValidation().requireValueInList(STATUTS_VALIDES, true).build();
      sheet.getRange(2, colStatut, 500, 1).setDataValidation(regle);
    }
    if (nom === SHEET_HISTORIQUE) sheet.appendRow(["Date", "ID", "Action", "Détail"]);
  }
  return sheet;
}

function rowToObject(row) {
  const obj = {};
  COLONNES.forEach((col, idx) => { obj[col] = row[idx]; });
  return obj;
}

function checkToken(token) {
  const stored = PropertiesService.getScriptProperties().getProperty("CLASSEUR_TOKEN");
  if (!stored || token !== stored) {
    return jsonOutput(JSON.stringify({ error: "unauthorized" }));
  }
  return null;
}

function jsonOutput(text) {
  return ContentService.createTextOutput(text).setMimeType(ContentService.MimeType.JSON);
}

function csvOutput(text) {
  return ContentService.createTextOutput(text).setMimeType(ContentService.MimeType.CSV);
}
